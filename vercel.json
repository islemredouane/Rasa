{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/gaming", "destination": "/activities", "permanent": true },
    { "source": "/gaming.html", "destination": "/activities", "permanent": true },
    { "source": "/frensh", "destination": "/literature/french", "permanent": true },
    { "source": "/frensh.html", "destination": "/literature/french", "permanent": true },
    { "source": "/arabic", "destination": "/literature/arabic", "permanent": true },
    { "source": "/arabic.html", "destination": "/literature/arabic", "permanent": true },
    { "source": "/english", "destination": "/literature/english", "permanent": true },
    { "source": "/english.html", "destination": "/literature/english", "permanent": true },
    { "source": "/french", "destination": "/literature/french", "permanent": true },
    { "source": "/french.html", "destination": "/literature/french", "permanent": true },
    { "source": "/chess-tournament-regisrations", "destination": "/chess", "permanent": true },
    { "source": "/chess-tournament-regisrations.html", "destination": "/chess", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/(css|js|data)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(favicon.ico|rasa-logo.png|rasa-favicon.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|robots.txt|sitemap.xml)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ]
}
